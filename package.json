{
  "name": "advocate-ai",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "NODE_OPTIONS=--no-experimental-strip-types expo start",
    "android": "NODE_OPTIONS=--no-experimental-strip-types expo run:android",
    "ios": "NODE_OPTIONS=--no-experimental-strip-types expo run:ios",
    "prebuild": "NODE_OPTIONS=--no-experimental-strip-types expo prebuild --clean",
    "prebuild:android": "NODE_OPTIONS=--no-experimental-strip-types expo prebuild --platform android --clean",
    "lint": "tsc --noEmit",
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/expo-modules-core/package.json',j=JSON.parse(fs.readFileSync(p));if(!j['react-native']){j['react-native']='src/index.ts';fs.writeFileSync(p,JSON.stringify(j,null,2))}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@notifee/react-native": "^9.1.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-native-ml-kit/text-recognition": "^1.0.0",
    "@shopify/react-native-skia": "^2.11.1",
    "expo": "^54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "llama.rn": "^0.11.0",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "whisper.rn": "^0.7.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/react-native-skia"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-ml-kit/text-recognition",
          "whisper.rn"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "^19.2.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "typescript": "~5.9.2"
  }
}
